# Serves the built UI and forwards /api/* to the MockHub server.
# The nginx image fills in ${MOCKHUB_SERVER} (host:port) from the environment at container start;
# nginx's own variables ($host, $request_uri, ...) are left alone because they are not set in the environment.

upstream mockhub_server {
    server ${MOCKHUB_SERVER};
}

# /api/<path> -> /<path>. Taken from the raw request URI, so encoded characters (%20, %2F, ...)
# reach the mock server exactly as the client sent them; mocks are matched against the raw path.
map $request_uri $mockhub_uri {
    ~^/api(?<rest>/.*)$  $rest;
    default              /;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://mockhub_server$mockhub_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The upload size limit is enforced by the MockHub server (spring.servlet.multipart.max-file-size).
        client_max_body_size 0;
    }

    # Hashed build assets never change, so they can be cached for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths fall back to index.html, which must not be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
